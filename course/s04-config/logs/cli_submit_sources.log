# S4 CLI 实跑（2026-10-29 · Day 2）：路径覆盖 + 私有变量掩码
# 命令（三条，真实执行）：
#   export PYTHONPATH=platform/src
#   .venv/bin/python -m porryllmops.cli --db /tmp/s04_config.json \
#       submit --task finetune-7b --set lr=1e-4 \
#       --set data_path=oss://team-a/corpus-v3 --set hf_token=hf_real_value \
#       --inject image_digest=sha256:9f2c --simulate ok --gpus 8
#
# 关注三件事：
#   ① data_path 来自 run_override，而不是模板默认
#   ② hf_token 在输出里是 *** —— 存储里仍是真值，否则训练连不上
#   ③ image_digest 来自平台注入，优先级高于用户

