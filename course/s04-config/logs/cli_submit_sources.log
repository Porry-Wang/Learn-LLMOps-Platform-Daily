run run-0001  state=pending  attempt=1
  config cv-0001-7d6e6deb（9 个字段）
    batch_size         32                     ← template
    data_path          oss://team-a/corpus-v3 ← run_override
    hf_token           ***                    ← run_override
    image_digest       sha256:9f2c            ← platform_injected
    lr                 0.0001                 ← run_override
    max_steps          5000                   ← template
    optimizer          adamw                  ← template
    precision          bf16                   ← template
    seq_len            2048                   ← template

